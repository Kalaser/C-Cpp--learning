{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "task g++ (Debug)",
            "type": "shell",
            "command": "C:\\MinGW64\\mingw64\\bin\\g++.exe",
            "args": [
                "-g",
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}_debug.exe",
                "-L",
                "${fileDirname}\\EasyX",
                "-leasyx",
                "-lstdc++",
                "-lmsimg32",
                "-lgdiplus",
                "-lgdi32",
                "-lwinmm"
            ],
            "options": {
                "cwd": "C:\\MinGW64\\mingw64\\bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        },
        {
            "label": "task g++ (Release)",
            "type": "shell",
            "command": "C:\\MinGW64\\mingw64\\bin\\g++.exe",
            "args": [
                "-O3",
                "-DNDEBUG",
                "-std=c++17",
                "-march=native",
                "-flto",
                "-fno-fat-lto-objects",
                "-Wall",
                "-Wextra",
                "-ffunction-sections",
                "-fdata-sections",
                "-Wl,--gc-sections",
                "-s",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}_release.exe",
                "-L",
                "${fileDirname}\\EasyX",
                "-leasyx",
                "-lstdc++",
                "-lmsimg32",
                "-lgdiplus",
                "-lgdi32",
                "-lwinmm"
            ],
            "options": {
                "cwd": "C:\\MinGW64\\mingw64\\bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe 生成活动文件 (Optimized)",
            "command": "C:/MinGW64/mingw64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-O2",
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "C:/MinGW64/mingw64/bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "优化编译器生成的任务。"
        }
    ]
}